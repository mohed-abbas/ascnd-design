# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-mcp session artifacts (screenshots/console logs)
.playwright-mcp/

# Local-only scratch: debug screenshots, throwaway HTML, vendored references and
# the raw rock/GLB sources the shipped cut-outs were derived from. Never served,
# never committed — delete the folder once you're sure you don't want the files.
.local-archive/

# Uncropped Figma exports for the portfolio globe — kept locally for re-cropping,
# never served and never committed. SOURCES.md is the exception: it records the
# Figma node IDs + export scales, so the ignored pixels can always be re-pulled.
portfolio-src/*
!portfolio-src/SOURCES.md

# Local-only drops that a `git add -A` has already swept into a commit twice.
# Neither is referenced by any code:
#   • cursor-trail-main/ — a vendored Vite/GLSL experiment. If it ever ships it
#     should be a deliberate fork under components/, per the heavy-effect
#     contract in CLAUDE.md, not a raw drop at the repo root.
#   • public/portfolio/cloud-backup/ — 24 grey placeholder SVGs, the
#     pre-real-work tiles the project registry says are gone.
# Ignored rather than deleted: the files are the owner's to remove.
/cursor-trail-main/
/public/portfolio/cloud-backup/
